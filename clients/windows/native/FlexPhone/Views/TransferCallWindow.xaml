<Window x:Class="FlexPhone.Views.TransferCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Transfer Call"
        Height="390" Width="560"
        MinHeight="340" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Background="#101418" Foreground="#f7f7f7"
        PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.Name="Transfer call">
    <Grid Margin="16" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Transfer this active call"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"
                   AutomationProperties.Name="Transfer this active call"/>

        <TextBlock Grid.Row="1" Text="Transfer type"/>
        <ComboBox x:Name="TransferTypeBox"
                  Grid.Row="2"
                  MinHeight="32"
                  Margin="0,4,0,12"
                  SelectionChanged="TransferTypeBox_SelectionChanged"
                  AutomationProperties.Name="Transfer type">
            <ComboBoxItem Content="Internal extension" Tag="internal" IsSelected="True"/>
            <ComboBoxItem Content="External phone number" Tag="external"/>
            <ComboBoxItem Content="Another PBX system" Tag="pbx"/>
        </ComboBox>

        <StackPanel Grid.Row="3">
            <TextBlock x:Name="DestinationLabel" Text="Extension"/>
            <TextBox x:Name="DestinationBox"
                     MinHeight="32"
                     Margin="0,4,0,12"
                     AutomationProperties.Name="Transfer destination"
                     AutomationProperties.HelpText="Enter the extension, phone number, or user part to transfer this call to."/>

            <TextBlock x:Name="DeviceLabel" Text="Signed-in device" Visibility="Collapsed"/>
            <ComboBox x:Name="DeviceBox"
                      MinHeight="32"
                      Margin="0,4,0,12"
                      Visibility="Collapsed"
                      IsEditable="False"
                      AutomationProperties.Name="Signed-in FlexPhone device"
                      AutomationProperties.HelpText="Choose one of your online FlexPhone devices."/>

            <TextBlock x:Name="ServerLabel" Text="PBX system" Visibility="Collapsed"/>
            <ComboBox x:Name="ServerBox"
                      MinHeight="32"
                      Margin="0,4,0,12"
                      IsEditable="True"
                      Visibility="Collapsed"
                      AutomationProperties.Name="PBX system"
                      AutomationProperties.HelpText="Choose or type the PBX domain for the transfer target."/>
        </StackPanel>

        <TextBlock x:Name="PreviewText"
                   Grid.Row="4"
                   TextWrapping="Wrap"
                   Foreground="#b8c1cc"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="Transfer preview"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="TransferButton"
                    Content="Transfer"
                    MinWidth="92"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="TransferButton_Click"
                    AutomationProperties.Name="Transfer call"/>
            <Button Content="Cancel"
                    MinWidth="90"
                    IsCancel="True"
                    Click="CancelButton_Click"
                    AutomationProperties.Name="Cancel"/>
        </StackPanel>
    </Grid>
</Window>
