<Window x:Class="FlexPhone.Views.PeopleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contacts" Height="620" Width="860"
        MinHeight="500" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="#101418" Foreground="#f7f7f7"
        PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.Name="Flex Phone contacts">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="0,3,10,8"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,10,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Grid.Row="0" Margin="0,0,0,10"
                   Text="Contacts"
                   AutomationProperties.Name="Contacts status"
                   AutomationProperties.LiveSetting="Polite"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Groups" Grid.Column="0" Margin="0,0,12,0">
                <TreeView x:Name="GroupsTree"
                          SelectedItemChanged="GroupsTree_SelectedItemChanged"
                          AutomationProperties.Name="Contact groups"
                          AutomationProperties.HelpText="Choose a contact group. The contacts table updates to the selected group.">
                    <TreeViewItem Header="All contacts" Tag="__all" IsSelected="True"/>
                    <TreeViewItem Header="Favorites" Tag="__favorites"/>
                    <TreeViewItem Header="General" Tag="General"/>
                </TreeView>
            </GroupBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button x:Name="AddContactButton" Content="Add contact" Click="AddContactButton_Click"
                            AutomationProperties.Name="Add contact"/>
                    <Button x:Name="EditContactButton" Content="Edit contact" Click="EditContactButton_Click"
                            AutomationProperties.Name="Edit selected contact"/>
                    <Button x:Name="RemoveContactButton" Content="Remove contact" Click="RemoveContactButton_Click"
                            AutomationProperties.Name="Remove selected contact"/>
                    <Button x:Name="SaveDirectoryContactButton" Content="Save to contacts" Click="SaveDirectoryContactButton_Click"
                            AutomationProperties.Name="Save selected directory entry to contacts"/>
                    <Button Content="Refresh" Click="RefreshButton_Click"
                            AutomationProperties.Name="Refresh"/>
                </WrapPanel>

                <DataGrid x:Name="ContactsGrid" Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          SelectionChanged="ContactsGrid_SelectionChanged"
                          MouseDoubleClick="ContactsGrid_MouseDoubleClick"
                          AutomationProperties.Name="Contacts table"
                          AutomationProperties.HelpText="Use arrow keys to choose a contact. Use the context menu or buttons for actions.">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="CallMenuItem" Header="_Call" Click="CallMenuItem_Click"
                                      AutomationProperties.Name="Call"/>
                            <MenuItem x:Name="IntercomMenuItem" Header="_Intercom" Click="IntercomMenuItem_Click"
                                      AutomationProperties.Name="Intercom"/>
                            <Separator/>
                            <MenuItem Header="Send _text message" Click="SendTextMenuItem_Click"
                                      AutomationProperties.Name="Send text message"/>
                            <MenuItem Header="Send _voicemail" Click="SendVoicemailMenuItem_Click"
                                      AutomationProperties.Name="Send voicemail"/>
                            <Separator/>
                            <MenuItem x:Name="ContextSaveDirectoryMenuItem" Header="_Save to contacts" Click="SaveDirectoryContactButton_Click"
                                      AutomationProperties.Name="Save to contacts"/>
                            <MenuItem x:Name="ContextEditContactMenuItem" Header="_Edit contact" Click="EditContactButton_Click"
                                      AutomationProperties.Name="Edit contact"/>
                            <MenuItem x:Name="ContextRemoveContactMenuItem" Header="_Remove contact" Click="RemoveContactButton_Click"
                                      AutomationProperties.Name="Remove contact"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="2*"/>
                        <DataGridTextColumn Header="Extension" Binding="{Binding Extension}" Width="*"/>
                        <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="*"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                        <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="*"/>
                        <DataGridCheckBoxColumn Header="Favorite" Binding="{Binding IsFavorite}" Width="Auto"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.5*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock Text="Message"/>
                    <TextBox x:Name="MessageTextBox" MinHeight="70"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             AutomationProperties.Name="Message to selected contact"/>
                </StackPanel>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Text="Press Escape to close."
                   Foreground="#b8c1cc"
                   AutomationProperties.Name="Press Escape to close."/>
    </Grid>
</Window>
