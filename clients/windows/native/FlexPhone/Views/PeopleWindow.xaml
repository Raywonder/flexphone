<Window x:Class="FlexPhone.Views.PeopleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="People" Height="520" Width="620"
        MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="#101418" Foreground="#f7f7f7"
        PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.Name="Flex Phone people">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Grid.Row="0" Margin="0,0,0,10"
                   Text="People"
                   AutomationProperties.Name="People status"
                   AutomationProperties.LiveSetting="Polite"/>

        <ListBox x:Name="PeopleList" Grid.Row="1" MinHeight="240"
                 MouseDoubleClick="PeopleList_MouseDoubleClick"
                 AutomationProperties.Name="People online and offline"
                 AutomationProperties.HelpText="Use the context menu for actions on the selected person. Online people can be called or reached by intercom. Offline people can receive voicemail or a text message for later.">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="CallMenuItem" Header="_Call" Click="CallMenuItem_Click"
                              AutomationProperties.Name="Call"/>
                    <MenuItem x:Name="IntercomMenuItem" Header="_Intercom" Click="IntercomMenuItem_Click"
                              AutomationProperties.Name="Intercom"/>
                    <Separator/>
                    <MenuItem Header="Send _text message" Click="SendTextMenuItem_Click"
                              AutomationProperties.Name="Send text message"/>
                    <MenuItem Header="Send _voicemail" Click="SendVoicemailMenuItem_Click"
                              AutomationProperties.Name="Send voicemail"/>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4"
                                AutomationProperties.Name="{Binding AccessibleSummary}">
                        <TextBlock Text="{Binding AccessibleSummary}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Status}" Foreground="#b8c1cc"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Message"/>
            <TextBox x:Name="MessageTextBox" MinHeight="70" Margin="0,4,0,10"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     AutomationProperties.Name="Message to selected person"/>
        </StackPanel>

    </Grid>
</Window>
