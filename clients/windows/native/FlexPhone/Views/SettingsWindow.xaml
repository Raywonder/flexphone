<Window x:Class="FlexPhone.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flex Phone Settings" Height="560" Width="620"
        MinHeight="480" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="#101418" Foreground="#f7f7f7"
        AutomationProperties.Name="Flex Phone settings">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="General">
                <StackPanel Margin="12">
                    <CheckBox x:Name="CheckUpdatesCheckBox" Content="Check for updates" Margin="0,8,0,0"
                              AutomationProperties.Name="Check for updates"/>
                    <CheckBox x:Name="AutoInstallUpdatesCheckBox" Content="Automatically install updates" Margin="0,8,0,0"
                              AutomationProperties.Name="Automatically install updates"/>
                    <CheckBox x:Name="AnnounceUpdateInstallRestartCheckBox" Content="Announce before installing and restarting for updates" Margin="0,8,0,0"
                              AutomationProperties.Name="Announce before installing and restarting for updates"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Startup">
                <StackPanel Margin="12">
                    <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start Flex Phone when Windows boots"
                              AutomationProperties.Name="Start Flex Phone when Windows boots"
                              AutomationProperties.HelpText="When enabled, Flex Phone starts automatically after you sign in to Windows."/>
                    <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Minimize to system tray"
                              Margin="0,12,0,0"
                              AutomationProperties.Name="Minimize to system tray"/>
                    <CheckBox x:Name="StartMinimizedCheckBox" Content="Start minimized to tray" Margin="0,8,0,0"
                              AutomationProperties.Name="Start minimized to tray"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Connection">
                <StackPanel Margin="12">
                    <TextBlock Text="Phone provider"/>
                    <ComboBox x:Name="ProviderTypeComboBox" Margin="0,4,0,10"
                              AutomationProperties.Name="Phone provider">
                        <ComboBoxItem Content="Flex PBX"/>
                        <ComboBoxItem Content="Callcentric"/>
                        <ComboBoxItem Content="Other SIP provider"/>
                    </ComboBox>
                    <TextBlock Text="Local SIP port"/>
                    <TextBox x:Name="LocalPortBox" Margin="0,4,0,10"
                             AutomationProperties.Name="Local SIP port"/>
                    <CheckBox x:Name="RememberSignInCheckBox" Content="Remember sign-in on this Windows account"
                              AutomationProperties.Name="Remember sign-in on this Windows account"/>
                    <CheckBox x:Name="UseCustomTurnCheckBox" Content="Use custom TURN server"
                              Margin="0,8,0,0"
                              AutomationProperties.Name="Use custom TURN server"/>
                    <TextBlock Text="TURN server" Margin="0,10,0,0"/>
                    <TextBox x:Name="TurnServerBox" Margin="0,4,0,10"
                             AutomationProperties.Name="TURN server"/>
                    <Button Content="Open client download page" Click="DownloadPageButton_Click"
                            HorizontalAlignment="Left" Margin="0,10,0,0"
                            AutomationProperties.Name="Open Flex Phone client download page"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Calling">
                <StackPanel Margin="12">
                    <CheckBox x:Name="AutoAnswerCheckBox" Content="Auto-answer incoming calls"
                              AutomationProperties.Name="Auto-answer incoming calls"/>
                    <TextBlock Text="Display name" Margin="0,14,0,0"/>
                    <TextBox x:Name="DisplayNameBox" Margin="0,4,0,10"
                             AutomationProperties.Name="Display name"
                             AutomationProperties.HelpText="This is the name other Flex PBX users hear or see when you are online or placing calls."/>
                    <TextBlock Text="Spacebar during calls"/>
                    <ComboBox x:Name="SpacebarActionComboBox" Margin="0,4,0,10"
                              AutomationProperties.Name="Spacebar during calls">
                        <ComboBoxItem Content="Mute or unmute microphone"/>
                        <ComboBoxItem Content="End current call"/>
                        <ComboBoxItem Content="Hold or resume current call"/>
                        <ComboBoxItem Content="Transfer current call"/>
                        <ComboBoxItem Content="Conference open calls"/>
                        <ComboBoxItem Content="No action"/>
                    </ComboBox>
                    <TextBlock Text="Enter key default"/>
                    <ComboBox x:Name="EnterActionComboBox" Margin="0,4,0,10"
                              AutomationProperties.Name="Enter key default"
                              AutomationProperties.HelpText="Enter always activates the focused button. This setting controls Enter only when focus is not on a button or text field.">
                        <ComboBoxItem Content="Activate focused control"/>
                        <ComboBoxItem Content="Dial as intercom"/>
                        <ComboBoxItem Content="Open messages"/>
                    </ComboBox>
                    <TextBlock Text="Automatic queue sign-in and sign-out" Margin="0,14,0,0"/>
                    <ComboBox x:Name="AutoQueueModeComboBox" Margin="0,4,0,10"
                              AutomationProperties.Name="Automatic queue sign-in and sign-out"
                              AutomationProperties.HelpText="Default is off. Flex PBX admins can manage this by user, group, team, or server policy.">
                        <ComboBoxItem Content="Off"/>
                        <ComboBoxItem Content="Use my user setting"/>
                        <ComboBoxItem Content="Use group or team policy"/>
                        <ComboBoxItem Content="Use server policy"/>
                    </ComboBox>
                    <CheckBox x:Name="IntercomCheckBox" Content="Allow intercom calls" Margin="0,8,0,0"
                              AutomationProperties.Name="Allow intercom calls"/>
                    <TextBlock Text="Presence status" Margin="0,14,0,0"/>
                    <ComboBox x:Name="UserStatusComboBox" Margin="0,4,0,10"
                              AutomationProperties.Name="Presence status">
                        <ComboBoxItem Content="Available"/>
                        <ComboBoxItem Content="Busy"/>
                        <ComboBoxItem Content="Do not disturb"/>
                        <ComboBoxItem Content="Away"/>
                    </ComboBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="Audio">
                <StackPanel Margin="12">
                    <TextBlock Text="Microphone"/>
                    <ListBox x:Name="InputAudioDeviceComboBox" Height="92" Margin="0,4,0,10"
                              AutomationProperties.Name="Microphone"
                              AutomationProperties.HelpText="List box. Status: choose the microphone Flex Phone should use for calls."
                              KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    <TextBlock Text="Speaker or headset"/>
                    <ListBox x:Name="OutputAudioDeviceComboBox" Height="92" Margin="0,4,0,10"
                              AutomationProperties.Name="Speaker or headset"
                              AutomationProperties.HelpText="List box. Status: choose the speaker Flex Phone should use for calls."
                              KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    <TextBlock Text="Headset device" Margin="0,8,0,0"/>
                    <ListBox x:Name="HeadsetAudioDeviceListBox" Height="72" Margin="0,4,0,10"
                             AutomationProperties.Name="Headset device"
                             AutomationProperties.HelpText="List box. Status: choose the headset used by the headset route toggle."
                             KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    <CheckBox x:Name="FollowHeadsetForSoundsCheckBox" Content="Follow the selected headset for call sounds"
                              AutomationProperties.Name="Follow the selected headset for call sounds"
                              AutomationProperties.HelpText="Check box. Status: call alerts follow the selected headset route when checked."/>
                    <CheckBox x:Name="PlaySoundsCheckBox" Content="Play Flex Phone call sounds" Margin="0,8,0,0"
                              AutomationProperties.Name="Play Flex Phone call sounds"/>
                    <TextBlock Text="Sound volume" Margin="0,12,0,0"/>
                    <Slider x:Name="SoundVolumeSlider" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True"
                            Margin="0,4,0,2" ValueChanged="SoundVolumeSlider_ValueChanged"
                            AutomationProperties.Name="Sound volume"
                            AutomationProperties.HelpText="Slider. Status: use Left and Right Arrow to change volume."/>
                    <TextBlock x:Name="SoundVolumeValueText" Text="100 percent" HorizontalAlignment="Right"/>
                    <TextBlock Text="Incoming ringtone" Margin="0,14,0,0"/>
                    <ListBox x:Name="IncomingRingtoneComboBox" Height="110" Margin="0,4,0,10"
                              SelectionChanged="IncomingRingtoneComboBox_SelectionChanged"
                              AutomationProperties.Name="Incoming ringtone"
                              AutomationProperties.HelpText="List box. Status: focus a ringtone to preview it."
                              KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    <TextBlock Text="If a selected device is unavailable, Flex Phone falls back to the Windows default communications device." TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Hotkeys">
                <StackPanel Margin="12">
                    <TextBlock Text="Global call hotkeys"/>
                    <TextBlock Text="Answer incoming call" Margin="0,10,0,0"/>
                    <TextBox x:Name="AnswerHotKeyBox" Margin="0,4,0,8"
                             AutomationProperties.Name="Answer incoming call hotkey"
                             AutomationProperties.HelpText="Default is Control Shift A."/>
                    <TextBlock Text="Hang up current call"/>
                    <TextBox x:Name="HangupHotKeyBox" Margin="0,4,0,8"
                             AutomationProperties.Name="Hang up current call hotkey"
                             AutomationProperties.HelpText="Default is Control Shift H."/>
                    <TextBlock Text="Hold or resume current call"/>
                    <TextBox x:Name="HoldHotKeyBox" Margin="0,4,0,12"
                             AutomationProperties.Name="Hold or resume current call hotkey"
                             AutomationProperties.HelpText="Default is Control Shift O."/>
                    <TextBlock Text="Main window function keys" Margin="0,12,0,0"/>
                    <ListBox IsTabStop="True"
                             AutomationProperties.Name="Default function keys">
                        <ListBoxItem Content="F1: Pick up or answer incoming call"/>
                        <ListBoxItem Content="F2: End current call"/>
                        <ListBoxItem Content="F3: Hold or resume current call"/>
                        <ListBoxItem Content="F4: Transfer current call"/>
                        <ListBoxItem Content="F5: Start or stop recording"/>
                        <ListBoxItem Content="F6: Mute or unmute microphone"/>
                        <ListBoxItem Content="F7: Toggle queue sign-in"/>
                        <ListBoxItem Content="F8: Open voicemail"/>
                        <ListBoxItem Content="F9: Open messages"/>
                        <ListBoxItem Content="F10: Open contacts"/>
                        <ListBoxItem Content="F11: Toggle do not disturb"/>
                        <ListBoxItem Content="F12: Toggle call screening"/>
                    </ListBox>
                    <TextBlock Text="Main window focused shortcuts" Margin="0,12,0,0"/>
                    <ListBox IsTabStop="True"
                             AutomationProperties.Name="Main window focused shortcuts">
                        <ListBoxItem Content="Ctrl+D: Show or hide dialpad"/>
                        <ListBoxItem Content="Ctrl+M: Open messages"/>
                        <ListBoxItem Content="Ctrl+Shift+D: Toggle do not disturb"/>
                        <ListBoxItem Content="Ctrl+Shift+Q: Toggle queue sign-in"/>
                    </ListBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="Accessibility">
                <StackPanel Margin="12">
                    <CheckBox x:Name="AnnounceLineChangesCheckBox" Content="Announce line changes"
                              AutomationProperties.Name="Announce line changes"/>
                    <CheckBox x:Name="AnnounceQueueDurationCheckBox" Content="Announce queue status duration" Margin="0,8,0,0"
                              AutomationProperties.Name="Announce queue status duration"/>
                    <CheckBox x:Name="AnnounceCallEndedCheckBox" Content="Announce when a line becomes free" Margin="0,8,0,0"
                              AutomationProperties.Name="Announce when a line becomes free"/>
                    <CheckBox x:Name="DetailedLineAnnouncementsCheckBox" Content="Use detailed line announcements" Margin="0,8,0,0"
                              AutomationProperties.Name="Use detailed line announcements"/>
                    <CheckBox x:Name="ShowKeyboardHintsCheckBox" Content="Show keyboard shortcut hints" Margin="0,8,0,0"
                              AutomationProperties.Name="Show keyboard shortcut hints"/>
                    <CheckBox x:Name="ShowDialPadCheckBox" Content="Show dialpad by default" Margin="0,8,0,0"
                              AutomationProperties.Name="Show dialpad by default"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Advanced">
                <StackPanel Margin="12">
                    <TextBlock Text="Server and provider accounts" FontWeight="SemiBold"/>
                    <TextBlock Text="Hosted server choices are normally supplied by the server. Add a provider only when your account is permitted to use another service." TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <TextBox x:Name="DefaultServerBox" Margin="0,4,0,4"
                             AutomationProperties.Name="Server or provider domain"
                             AutomationProperties.HelpText="Text box. Status: advanced server or provider domain."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add" Click="AddProviderButton_Click" AutomationProperties.Name="Add server or provider"/>
                        <Button Content="Remove" Click="RemoveProviderButton_Click" AutomationProperties.Name="Remove server or provider"/>
                    </StackPanel>
                    <ListBox x:Name="ProviderServerListBox" Height="78" Margin="0,4,0,10"
                             AutomationProperties.Name="Configured server and provider accounts"
                             AutomationProperties.HelpText="List box. Status: configured server and provider accounts."/>
                    <Button x:Name="AdvancedPathsButton" Content="Advanced server paths" Click="AdvancedPathsButton_Click"
                            HorizontalAlignment="Left" Margin="0,0,0,8"
                            AutomationProperties.Name="Advanced server paths"/>
                    <StackPanel x:Name="AdvancedPathsPanel" Visibility="Collapsed">
                        <TextBlock Text="Provisioning link"/>
                        <TextBox x:Name="ProvisioningLinkBox" IsReadOnly="True" TextWrapping="Wrap"
                                 AutomationProperties.Name="Provisioning link"/>
                        <TextBlock Text="Browser login path" Margin="0,10,0,0"/>
                        <TextBox x:Name="BrowserLoginPathBox" Margin="0,4,0,8"
                                 AutomationProperties.Name="Browser login path"/>
                        <TextBlock Text="Account recovery path"/>
                        <TextBox x:Name="AccountRecoveryPathBox" Margin="0,4,0,8"
                                 AutomationProperties.Name="Account recovery path"/>
                        <TextBlock Text="Update manifest path"/>
                        <TextBox x:Name="UpdateManifestPathBox" Margin="0,4,0,8"
                                 AutomationProperties.Name="Update manifest path"/>
                        <TextBlock Text="Client download path"/>
                        <TextBox x:Name="ClientDownloadPathBox" Margin="0,4,0,8"
                                 AutomationProperties.Name="Client download path"/>
                        <TextBlock Text="Queue login code"/>
                        <TextBox x:Name="QueueLoginCodeBox" Margin="0,4,0,8"
                                 AutomationProperties.Name="Queue login code"/>
                        <CheckBox x:Name="QueueUsesSingleToggleCodeCheckBox" Content="Use the same queue code for in and out"
                                  AutomationProperties.Name="Use the same queue code for in and out"/>
                        <TextBlock Text="Queue logout code"/>
                        <TextBox x:Name="QueueLogoutCodeBox" Margin="0,4,0,8"
                                 AutomationProperties.Name="Queue logout code"/>
                        <TextBlock Text="Voicemail code"/>
                        <TextBox x:Name="VoicemailCodeBox" Margin="0,4,0,8"
                                 AutomationProperties.Name="Voicemail code"/>
                        <TextBlock Text="Do not disturb toggle code"/>
                        <TextBox x:Name="DndToggleCodeBox" Margin="0,4,0,8"
                                 AutomationProperties.Name="Do not disturb toggle code"/>
                        <TextBlock Text="Call screening toggle code"/>
                        <TextBox x:Name="CallScreeningToggleCodeBox" Margin="0,4,0,8"
                                 AutomationProperties.Name="Call screening toggle code"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Click="SaveButton_Click" MinWidth="82" Margin="0,0,8,0"/>
            <Button Content="Cancel" Click="CancelButton_Click" MinWidth="82"/>
        </StackPanel>
    </Grid>
</Window>
