<Window x:Class="FlexPhone.Views.ExtensionDialChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Choose Extension"
        Height="360" Width="620"
        MinHeight="300" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="#101418" Foreground="#f7f7f7"
        PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.Name="Choose extension to dial">
    <Grid Margin="16" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="InstructionText"
                   Grid.Row="0"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"/>

        <ListBox x:Name="ChoicesList"
                 Grid.Row="1"
                 DisplayMemberPath="AccessibleSummary"
                 MouseDoubleClick="ChoicesList_MouseDoubleClick"
                 AutomationProperties.Name="Matching extension choices"
                 AutomationProperties.HelpText="Choose which matching user and phone system to dial."/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="DialButton"
                    Content="Dial selected"
                    MinWidth="110"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="DialButton_Click"
                    AutomationProperties.Name="Dial selected extension"/>
            <Button Content="Cancel"
                    MinWidth="90"
                    IsCancel="True"
                    Click="CancelButton_Click"
                    AutomationProperties.Name="Cancel"/>
        </StackPanel>
    </Grid>
</Window>
