<Window x:Class="FlexPhone.Views.CallLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flex Phone Call Log" Height="520" Width="720"
        MinHeight="360" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="#101418" Foreground="#f7f7f7"
        AutomationProperties.Name="Flex Phone call log">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="FilterComboBox"
                      MinWidth="180"
                      SelectionChanged="FilterComboBox_SelectionChanged"
                      AutomationProperties.Name="Call log filter">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="Calls"/>
                <ComboBoxItem Content="SIP"/>
                <ComboBoxItem Content="Audio"/>
                <ComboBoxItem Content="Errors"/>
                <ComboBoxItem Content="Accounts"/>
                <ComboBoxItem Content="Updates"/>
                <ComboBoxItem Content="System"/>
            </ComboBox>
        </StackPanel>

        <ListBox x:Name="EntriesListBox"
                 Grid.Row="1"
                 AutomationProperties.Name="Filtered call log entries">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2"
                Content="Close"
                HorizontalAlignment="Right"
                MinWidth="82"
                Margin="0,12,0,0"
                Click="CloseButton_Click"
                AutomationProperties.Name="Close call log"/>
    </Grid>
</Window>
