<Window x:Class="FlexPhone.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flex Phone Update" Height="460" Width="640"
        MinHeight="420" MinWidth="540"
        WindowStartupLocation="CenterOwner"
        Background="#101418" Foreground="#f7f7f7"
        AutomationProperties.Name="Flex Phone update">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryText" Grid.Row="0" Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="Update summary"
                   AutomationProperties.LiveSetting="Polite"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="Update information">
            <TextBlock x:Name="UpdateInfoText"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Flex Phone update information"/>
        </ScrollViewer>

        <Button Grid.Row="2"
                x:Name="OkButton"
                Content="OK"
                Click="OkButton_Click"
                IsDefault="True"
                IsCancel="True"
                MinWidth="92"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                AutomationProperties.Name="OK"/>
    </Grid>
</Window>
