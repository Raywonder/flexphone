<Window x:Class="FlexPhone.Views.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair this phone" Height="500" Width="560"
        MinHeight="420" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Background="#101418" Foreground="#f7f7f7"
        AutomationProperties.Name="Pair this phone">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Pairing links another Flex Phone device to this same extension."
                   AutomationProperties.Name="Pairing status"
                   AutomationProperties.LiveSetting="Polite"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Pairing code"/>
            <TextBox x:Name="PairingCodeBox" IsReadOnly="True" FontSize="22" Margin="0,4,0,10"
                     AutomationProperties.Name="Pairing code"/>
            <TextBlock Text="Pairing link"/>
            <TextBox x:Name="PairingUrlBox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,4,0,10"
                     AutomationProperties.Name="Pairing link"/>
        </StackPanel>

        <GroupBox Grid.Row="2" Header="Use this code for" Margin="0,4,0,12">
            <ListBox AutomationProperties.Name="Pairing examples">
                <ListBoxItem Content="Link a desktop phone in another room to this same extension."/>
                <ListBoxItem Content="Sign in to Flex Phone on another Windows device without changing this device."/>
                <ListBoxItem Content="Prepare a second location so calls can ring on all linked devices."/>
                <ListBoxItem Content="Transfer a call to another linked device while Flex PBX holds the caller."/>
                <ListBoxItem Content="Keep groundwire or other linked devices from blocking this device from ringing."/>
            </ListBox>
        </GroupBox>

        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button Content="Copy code" Click="CopyCodeButton_Click" MinWidth="94" Margin="0,0,8,0"
                    AutomationProperties.Name="Copy pairing code"/>
            <Button Content="Check code" Click="CheckCodeButton_Click" MinWidth="94" Margin="0,0,8,0"
                    AutomationProperties.Name="Check pairing code"/>
            <Button Content="Refresh" Click="RefreshButton_Click" MinWidth="86" Margin="0,0,8,0"
                    AutomationProperties.Name="Refresh pairing code"/>
            <Button Content="Close" Click="CloseButton_Click" MinWidth="86"
                    AutomationProperties.Name="Close pairing"/>
        </WrapPanel>
    </Grid>
</Window>
