<Window x:Class="FlexPhone.Views.MessagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Messages" Height="560" Width="620"
        MinHeight="440" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="#101418" Foreground="#f7f7f7"
        AutomationProperties.Name="Flex Phone messages">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Grid.Row="0" Margin="0,0,0,10"
                   Text="Messages"
                   AutomationProperties.Name="Messages status"
                   AutomationProperties.LiveSetting="Polite"/>

        <ListBox x:Name="MessagesList" Grid.Row="1" MinHeight="220"
                 AutomationProperties.Name="Message history"
                 AutomationProperties.HelpText="Internal Flex PBX extension messages for this extension. Outside SMS is not enabled here yet.">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding AccessibleSummary}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Date}" Foreground="#b8c1cc"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="To extension"/>
            <TextBox x:Name="ToBox" MinHeight="32" Margin="0,4,0,8"
                     AutomationProperties.Name="Message recipient extension"/>

            <TextBlock Text="Message"/>
            <TextBox x:Name="BodyBox" MinHeight="82" Margin="0,4,0,10"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     AutomationProperties.Name="Message text"/>

            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Refresh" Click="RefreshButton_Click" MinWidth="86" Margin="0,0,8,0"
                        AutomationProperties.Name="Refresh messages"/>
                <Button Content="Send" Click="SendButton_Click" MinWidth="86" Margin="0,0,8,0"
                        AutomationProperties.Name="Send message"/>
                <Button Content="Close" Click="CloseButton_Click" MinWidth="86"
                        AutomationProperties.Name="Close messages"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
