<Window x:Class="FlexPhone.Views.IncomingCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Incoming Call" Height="320" Width="460"
        MinHeight="280" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="#101418" Foreground="#f7f7f7"
        Topmost="True"
        AutomationProperties.Name="Incoming call">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryText"
                   Grid.Row="0"
                   FontSize="20"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="Incoming call summary"
                   AutomationProperties.LiveSetting="Assertive"/>

        <TextBlock x:Name="DetailText"
                   Grid.Row="1"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="#b8c1cc"
                   AutomationProperties.Name="Incoming call detail"/>

        <WrapPanel Grid.Row="2" Margin="0,18,0,8">
            <Button x:Name="AnswerButton"
                    Content="Pick up"
                    MinWidth="96"
                    Margin="0,0,8,8"
                    Click="AnswerButton_Click"
                    AutomationProperties.Name="Pick up incoming call"/>
            <Button x:Name="DeclineButton"
                    Content="Decline"
                    MinWidth="96"
                    Margin="0,0,8,8"
                    Click="DeclineButton_Click"
                    AutomationProperties.Name="Decline incoming call"/>
            <Button x:Name="VoicemailButton"
                    Content="Voicemail"
                    MinWidth="112"
                    Margin="0,0,8,8"
                    Click="VoicemailButton_Click"
                    AutomationProperties.Name="Send incoming call to voicemail"/>
        </WrapPanel>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="Transfer to"/>
            <TextBox x:Name="TransferDestinationBox"
                     Margin="0,4,0,8"
                     AutomationProperties.Name="Transfer destination"/>
            <Button x:Name="TransferButton"
                    Content="Answer and transfer"
                    HorizontalAlignment="Left"
                    MinWidth="148"
                    Click="TransferButton_Click"
                    AutomationProperties.Name="Answer and transfer incoming call"/>
        </StackPanel>

        <TextBlock Grid.Row="4"
                   x:Name="StatusText"
                   Foreground="#b8c1cc"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="Incoming call status"
                   AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</Window>
